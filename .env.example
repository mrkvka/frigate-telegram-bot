# Скопируй в .env и заполни секреты

BOT_TOKEN=
OWNER_CHAT_ID=123456789
# Несколько владельцев: OWNER_CHAT_ID=123456789,987654321

FRIGATE_URL=http://192.168.1.253:5000
CAMERA=front

# Если api.telegram.org недоступен — прокси (см. README-proxy.md)
# TG_API_BASE=https://your-proxy.example.com

# Автоотправка новых событий
AUTO_EVENTS=1
EVENT_POLL_SECS=10
CLIP_WAIT_SECS=10
EVENT_MERGE_GAP_SECS=30

# Нормализация видео для Telegram (0 = исходное разрешение)
FIX_TELEGRAM_VIDEO=1
VIDEO_FIX_WIDTH=0
VIDEO_FIX_FPS=0
VIDEO_FIX_CRF=23
VIDEO_FIX_TIMEOUT=240
MAX_VIDEO_MB=45
RNNOISE_MODEL=/frigate_config/rnnoise.rnnn

# Надёжность загрузки
SEND_VIDEO_RETRIES=5
SEND_VIDEO_RETRY_DELAY=8

# Мониторинг Frigate + авто-рестарт контейнера
MONITOR_ENABLED=1
MONITOR_INTERVAL=60
FRIGATE_AUTORESTART=1
FRIGATE_CONTAINER=frigate
RECORDINGS_DIR=/media/frigate/recordings

# Прокси для исходящего интернета (опционально)
# HTTPS_PROXY=http://proxy:port
# NO_PROXY=192.168.1.253,127.0.0.1,localhost
